# Reglas de alerta creadas al arrancar Grafana (provisioning), iguales en los dos entornos.
# A qué canal se avisa (Telegram solo en prod) se decide aparte, en el 5.3.2.
apiVersion: 1

groups:
  - orgId: 1
    name: contenedores
    folder: Tracker
    interval: 30s # cada cuánto se evalúan las reglas
    rules:
      # Web caída: qué webs de las desplegadas no están en marcha, por su nombre.
      # La consulta crea la lista de webs esperadas (web-1 … web-N, desde replicas_web) y quita
      # (unless) las que Telegraf ve encendidas: lo que queda son las caídas, una alerta por cada una.
      - uid: web-caida
        title: Web caída
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                (${webs_esperadas})
                unless on(container_name) docker_container_status_uptime_ns
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0
        for: 1m # 1 minuto seguido: un reinicio de unos segundos no avisa
        noDataState: OK # sin resultados = no falta ninguna web
        execErrState: Error
        labels:
          severidad: critica
          entorno: ${prefijo}
        annotations:
          summary: "{{ $labels.container_name }} no está en marcha (de ${replicas_web} webs)"
          description: Si quedan otras webs, Nginx reparte entre ellas. Ver por qué con make logs ENV=… SERVICIO=web-N.

      # CPU alta: un contenedor usa más del 80 % de un núcleo durante 2 minutos. El porcentaje
      # de Telegraf es por núcleo (con 8 núcleos, el máximo es 800 %); una web (un solo
      # proceso) no puede pasar mucho del 100 %, así que 80 % es estar casi al límite.
      - uid: cpu-alta
        title: CPU alta
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: max by (container_name) (docker_container_cpu_usage_percent{container_name=~"${prefijo}-.+", cpu="cpu-total"})
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 80
        for: 2m # 2 minutos seguidos: los picos de arranque (Grafana ~120 % unos segundos) no avisan
        noDataState: OK
        execErrState: Error
        labels:
          severidad: aviso
          entorno: ${prefijo}
        annotations:
          summary: "{{ $labels.container_name }}: CPU al {{ printf \"%.0f\" $values.A.Value }} % de un núcleo"
          description: Más del 80 % de un núcleo durante 2 minutos.

      # Servicio caído: qué pieza imprescindible (Nginx, la base de datos, MinIO y, en prod, la
      # caché) no está en marcha, por su nombre. "Web caída" no lo ve: las webs siguen encendidas.
      # Misma consulta que "Web caída", con la lista de servicios_criticos.
      - uid: servicio-caido
        title: Servicio caído
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              refId: A
              instant: true
              expr: >-
                (${servicios_esperados})
                unless on(container_name) docker_container_status_uptime_ns
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 0
        for: 1m
        noDataState: OK # sin resultados = no falta ningún servicio
        execErrState: Error
        labels:
          severidad: critica
          entorno: ${prefijo}
        annotations:
          summary: "{{ $labels.container_name }} no está en marcha"
          description: Sin Nginx o sin la base de datos la app no funciona. Ver por qué con make logs ENV=… SERVICIO=….

      # Errores 5xx: más de 10 respuestas de error del servidor en 5 minutos, contadas en los
      # logs de Nginx (Loki). Lo que de verdad nota el usuario: la web responde, pero mal.
      - uid: errores-5xx
        title: Errores 5xx
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: loki
            model:
              refId: A
              queryType: instant
              expr: 'sum(count_over_time({container_name="${prefijo}-balanceador"} |~ `HTTP/[0-9.]+" 5[0-9]{2} ` [5m]))'
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params:
                      - 10
        for: 0s # ya se cuentan 5 minutos en la consulta
        noDataState: OK # sin líneas 5xx no hay nada que contar: todo bien
        execErrState: Error
        labels:
          severidad: critica
          entorno: ${prefijo}
        annotations:
          summary: "${prefijo}: {{ $values.A.Value }} errores 5xx en Nginx en los últimos 5 minutos"
          description: Buscar las líneas en el panel Contenedores (Buscar en los logs) o en Explore.
