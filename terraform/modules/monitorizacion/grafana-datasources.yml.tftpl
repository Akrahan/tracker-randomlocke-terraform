# Fuentes de datos creadas al arrancar Grafana (provisioning): Prometheus (métricas)
# y Loki (logs) de este entorno.
apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: ${prometheus}
    isDefault: true
    editable: false

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: ${loki}
    editable: false
