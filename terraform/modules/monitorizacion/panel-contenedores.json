{
  "uid": "contenedores",
  "title": "Contenedores",
  "description": "Estado, CPU y memoria de cada contenedor de este entorno (Telegraf vía Prometheus) y sus logs (Alloy vía Loki). El desplegable «Contenedor» filtra todos los gráficos; «Buscar en los logs» filtra el texto de los logs.",
  "tags": [
    "tracker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contenedores en marcha",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(docker_container_status_uptime_ns{container_name=~\"$contenedor\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Tiempo encendido por contenedor",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ns"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_name) (docker_container_status_uptime_ns{container_name=~\"$contenedor\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "container_name": "Contenedor",
              "Value": "Encendido"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU por contenedor (%)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docker_container_cpu_usage_percent{container_name=~\"$contenedor\"}",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memoria por contenedor",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "docker_container_mem_usage{container_name=~\"$contenedor\"}",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Líneas de log por minuto",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_name) (count_over_time({container_name=~\"$contenedor\"} |~ \"(?i)$buscar\" [1m]))",
          "legendFormat": "{{container_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container_name=~\"$contenedor\"} |~ \"(?i)$buscar\""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "contenedor",
        "label": "Contenedor",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(docker_container_mem_usage, container_name)",
        "query": {
          "query": "label_values(docker_container_mem_usage, container_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "textbox",
        "name": "buscar",
        "label": "Buscar en los logs",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
