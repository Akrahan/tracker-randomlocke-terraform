# Copia este fichero como secrets.auto.tfvars y pon valores reales.
# secrets.auto.tfvars está en .gitignore: nunca se sube.
db_usuario  = "cambia_este_usuario"
db_password = "cambia_esta_contrasena"
# Solo hace falta si cache_activada = true (prod)
redis_password = "cambia_esta_contrasena"
minio_usuario  = "cambia_este_usuario"
minio_password = "cambia_esta_contrasena"   # 8 caracteres como mínimo
grafana_usuario  = "cambia_este_usuario"
grafana_password = "cambia_esta_contrasena" # 12 caracteres como mínimo
# Solo hace falta si telegram_activado = true (prod): token de @BotFather e ID del chat (getUpdates)
telegram_token   = "123456789:cambia_este_token"
telegram_chat_id = "123456789"
